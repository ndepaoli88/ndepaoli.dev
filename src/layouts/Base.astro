---
const { title = 'Nicolò De Paoli | Sviluppatore .NET e Azure', description = 'Articoli e progetti su .NET, Azure, Blazor e architetture cloud.' } = Astro.props;
---
<!doctype html>
<html lang="it">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><title>{title}</title><link rel="icon" href="/favicon.svg"/></head>
<body><div class="shell"><header><a class="brand" href="/">ndp</a><nav aria-label="Navigazione principale"><a href="/#about">Chi sono</a><a href="/#writing">Articoli</a><a href="/#projects">Progetti</a><a href="mailto:nicolo@ndepaoli.dev">Contatti</a></nav></header><main><slot/></main><footer><span>© {new Date().getFullYear()} Nicolò De Paoli</span><span>Realizzato con Astro · Ospitato su GitHub Pages</span></footer></div></body></html>
<style is:global>
:root{color-scheme:dark;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#0b1120;color:#e7edf7}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;line-height:1.7}a{color:inherit;text-decoration:none}a:hover{color:#7dd3fc}.shell{width:min(1050px,calc(100% - 44px));margin:auto}header{display:flex;align-items:center;justify-content:space-between;padding:30px 0;border-bottom:1px solid #263248}.brand{font-size:1.6rem;font-weight:800;letter-spacing:-.06em}.brand span,.accent{color:#38bdf8}nav{display:flex;gap:24px;font-size:.9rem;color:#a8b8cf}main{min-height:70vh}footer{display:flex;justify-content:space-between;gap:16px;padding:28px 0;border-top:1px solid #263248;color:#8293ad;font-size:.8rem}h1,h2,h3{line-height:1.18;letter-spacing:-.04em}h1{font-size:clamp(2.8rem,7vw,5rem);margin:16px 0}h2{font-size:2rem;margin:0 0 25px}p{color:#a8b8cf}.eyebrow{font-size:.8rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#38bdf8}.section{padding:70px 0;border-top:1px solid #263248}.button{display:inline-block;border:1px solid #38506d;padding:11px 19px;border-radius:8px;font-weight:600;margin:10px 12px 0 0}.button.primary{background:#38bdf8;color:#07111f;border-color:#38bdf8}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.card{padding:26px;border:1px solid #293a53;border-radius:12px;background:#101b2d}.card h3{margin:7px 0 10px}.card p{margin:0}.tag{color:#7dd3fc;font-size:.8rem}.article{max-width:740px;padding:75px 0}.article h1{font-size:clamp(2.5rem,6vw,4rem)}.article h2{font-size:1.6rem;margin-top:38px}.article pre{padding:18px;overflow-x:auto;border-radius:10px;background:#142239}.article code{font-size:.9em}.article a{color:#7dd3fc;text-decoration:underline}@media(max-width:650px){header{align-items:flex-start;gap:12px}nav{gap:12px;flex-wrap:wrap;justify-content:flex-end}.cards{grid-template-columns:1fr}footer{flex-direction:column}.section{padding:48px 0}}
</style>